{
  "name": "motion-videos-claude-code",
  "version": "1.0.0",
  "private": true,
  "description": "Programmatic motion graphics videos with Remotion, built for AI coding agents",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts SampleShowcase out/sample-showcase.mp4",
    "render:still": "remotion still src/index.ts SampleShowcase out/sample-showcase.png --frame=60",
    "render:german-election": "bash scripts/german-election/render.sh",
    "compositions": "remotion compositions src/index.ts",
    "typecheck": "tsc --noEmit",
    "upgrade": "remotion upgrade",
    "voice:setup": "python3 -m venv .voice/venv && .voice/venv/bin/pip install -r scripts/requirements-voice.txt",
    "voiceover": ".voice/venv/bin/python scripts/voiceover.py",
    "music": ".voice/venv/bin/python scripts/music.py",
    "sfx": ".voice/venv/bin/python scripts/sfx.py",
    "render:final": "bash scripts/render.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@remotion/cli": "4.0.535",
    "@remotion/google-fonts": "4.0.535",
    "@remotion/media": "4.0.535",
    "@remotion/media-utils": "4.0.535",
    "@remotion/shapes": "4.0.535",
    "@remotion/transitions": "4.0.535",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
